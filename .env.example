# Copy to .env and fill in. Never commit .env.

# Google Cloud: Places API (New) + Geocoding API (docs/API_KEYS_AND_FREE_TIERS.md, C1)
GOOGLE_API_KEY=
# SerpApi (docs/API_KEYS_AND_FREE_TIERS.md, C2)
SERPAPI_KEY=

# Optional: Business Profile API OAuth (C3)
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
# Optional: DataForSEO (C4)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Local database password (docker compose). Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Where the web app listens. In-house app without login: 127.0.0.1 = only this server (keep it).
APP_BIND=127.0.0.1
APP_PORT=8000

# false: normal logs and short error messages; true: detailed logs (API keys are never logged)
DEBUG=false

# Free-tier guard: the app refuses calls above these limits. 0 = no daily cap.
QUOTA_PLACES_DETAILS_MONTHLY=900
QUOTA_PLACES_DETAILS_DAILY=100
QUOTA_PLACES_TEXTSEARCH_MONTHLY=4500
QUOTA_PLACES_TEXTSEARCH_DAILY=150
# Text Search with phone/website fields (Enterprise SKU, ~1,000 free/month)
QUOTA_PLACES_TEXTSEARCH_ENTERPRISE_MONTHLY=900
QUOTA_PLACES_TEXTSEARCH_ENTERPRISE_DAILY=30
QUOTA_GEOCODING_MONTHLY=9000
QUOTA_GEOCODING_DAILY=0
QUOTA_SERPAPI_MONTHLY=240
# 40/day: one busy day cannot use up the month (a full 10-keyword ranking check = 20)
QUOTA_SERPAPI_DAILY=40
# Top 10 reviews via SerpApi costs 2 credits per audit. Off = Google's 5 reviews (free).
SERPAPI_REVIEWS_ENABLED=false
# Max active keywords per project. Each keyword uses 2 SerpApi searches per ranking run.
KEYWORD_CAP=10
# full = Local Pack + Local Finder (2 SerpApi searches per keyword); maps_only = 1 per keyword
RANKING_MODE=full
# Re-checking a keyword within this many hours reuses the saved result (no credits)
RANKING_CACHE_HOURS=24

# Competitors come from the stored ranking results (0 SerpApi searches)
COMPETITOR_MAX=10
# 1 Google Place Details per competitor (cached) for its review sample; false = search-result data only
COMPETITOR_DETAILS=true
# Competitor lookups stop when only this many Place Details are left (kept for client audits)
COMPETITOR_DETAILS_RESERVE=10

# Nightly clean-up (Google terms): Google content older than this many days is removed
GOOGLE_DATA_TTL_DAYS=30
CLEANUP_HOUR_UTC=3

# A temporary Google/SerpApi error (timeout, 429, 5xx) is retried this many times after a short wait
PROVIDER_RETRIES=1
# A queued/running job older than this many minutes is marked "interrupted" so it no longer blocks the project
JOB_STALE_MINUTES=120

# Contact for OpenStreetMap Nominatim (required by its usage policy)
NOMINATIM_USER_AGENT=local-seo-audit/0.1 (your-contact-email@example.com)
