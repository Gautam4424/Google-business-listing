# Copy to .env and fill in. Never commit .env.

# Google Cloud: Places API (New) + Geocoding API (IMPLEMENTATION_GUIDE.md, C1)
GOOGLE_API_KEY=
# SerpApi (IMPLEMENTATION_GUIDE.md, C2)
SERPAPI_KEY=

# Optional: Business Profile API OAuth (C3)
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
# Optional: DataForSEO (C4)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Local database password (docker-compose)
POSTGRES_PASSWORD=change-me

# Free-tier guard: the app refuses calls above these limits. 0 = no daily cap.
QUOTA_PLACES_DETAILS_MONTHLY=900
QUOTA_PLACES_DETAILS_DAILY=30
QUOTA_PLACES_TEXTSEARCH_MONTHLY=4500
QUOTA_PLACES_TEXTSEARCH_DAILY=150
# Text Search with phone/website fields (Enterprise SKU, ~1,000 free/month)
QUOTA_PLACES_TEXTSEARCH_ENTERPRISE_MONTHLY=900
QUOTA_PLACES_TEXTSEARCH_ENTERPRISE_DAILY=30
QUOTA_GEOCODING_MONTHLY=9000
QUOTA_GEOCODING_DAILY=0
QUOTA_SERPAPI_MONTHLY=240
QUOTA_SERPAPI_DAILY=0
# Top 10 reviews via SerpApi costs 2 credits per audit. Off = Google's 5 reviews (free).
SERPAPI_REVIEWS_ENABLED=false

# Days to keep raw Google responses before cleanup (only place_id is kept indefinitely)
GOOGLE_DATA_TTL_DAYS=30

# Contact for OpenStreetMap Nominatim (required by its usage policy)
NOMINATIM_USER_AGENT=local-seo-audit/0.1 (your-contact-email@example.com)
